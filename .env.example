# Database
DATABASE_URL=postgresql://bharatshield:bharatshield@localhost:5432/bharatshield
SQLITE_URL=sqlite:///./bharatshield.db
USE_SQLITE=true

# Docker Postgres (required for docker-compose)
POSTGRES_USER=bharatshield
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=bharatshield

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Auth Mode
DEMO_MODE=true

# ML Model
MODEL_PATH=../ml/models/fraud_model.pkl
FEATURE_CONFIG_PATH=../ml/models/feature_config.json

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# AI Risk Assistant (Gemini LLM — optional, falls back to rule-based if unset)
GEMINI_API_KEY=

# Frontend
VITE_API_URL=http://localhost:8000
